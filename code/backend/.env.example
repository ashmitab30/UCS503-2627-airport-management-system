PORT=4000
FRONTEND_URL=http://localhost:5173

# Either set DATABASE_URL directly...
DATABASE_URL=postgres://user:password@localhost:5432/airport_db

# Dedicated isolated test database URL (must end with _test)
TEST_DATABASE_URL=postgres://user:password@localhost:5432/airport_test

# ...or the discrete vars (pool.js falls back to these if unset above)
PGHOST=localhost
PGPORT=5432
PGUSER=user
PGPASSWORD=password
PGDATABASE=airport_db

JWT_SECRET=change_me_before_week_2
JWT_EXPIRES_IN=8h

# QR code HMAC signing secret & public frontend verification URL
QR_SIGNING_SECRET=change_me_qr_signing_secret_dev
PUBLIC_BASE_URL=http://localhost:5173

# SMTP email delivery configuration (required for production, mocked to console in dev)
# For real delivery, configure an SMTP provider (e.g. Gmail App Password, SendGrid, Mailgun, Amazon SES):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=operations@meridian.com
# SMTP_PASS=app_specific_password_here
# SMTP_FROM="Meridian Airport Operations" <operations@meridian.com>
