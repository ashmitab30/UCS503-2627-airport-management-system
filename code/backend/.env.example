PORT=4000
FRONTEND_URL=http://localhost:5173

# Either set DATABASE_URL directly...
DATABASE_URL=postgres://user:password@localhost:5432/airport_db

# ...or the discrete vars (pool.js falls back to these if unset above)
PGHOST=localhost
PGPORT=5432
PGUSER=user
PGPASSWORD=password
PGDATABASE=airport_db

JWT_SECRET=change_me_before_week_2
JWT_EXPIRES_IN=8h
